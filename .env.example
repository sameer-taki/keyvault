# ---------------------------------------------------------------------------
# Biz Key Vault — environment variables
# Copy to `.env.local` for local dev and set the same values in Vercel.
# NEVER commit a filled-in copy. Only this example file is tracked.
# ---------------------------------------------------------------------------

# --- Clerk (auth/identity) ----------------------------------------------------
# Dashboard: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Your Clerk Frontend API domain (e.g. example.clerk.accounts.dev, or your
# custom domain in production). Used by `supabase/config.toml` for local dev so
# the local Supabase accepts Clerk-issued JWTs. Not read by Next.js.
CLERK_DOMAIN=example.clerk.accounts.dev

# Where Clerk's hosted components live (defaults are fine).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/vault
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/vault

# --- Supabase (encrypted storage) --------------------------------------------
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
# Use the *anon* (public) key only. The browser passes the Clerk token via the
# accessToken callback; RLS does the rest. Do NOT put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
